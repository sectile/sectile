{
  "name": "sectile",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 --if-present build",
    "typecheck": "pnpm build && pnpm -r --workspace-concurrency=1 --if-present typecheck",
    "test": "pnpm build && pnpm -r --workspace-concurrency=1 --if-present test && node --test --test-concurrency=1 verification/cross-host/*.test.mjs && pnpm test:tooling",
    "test:cross-host": "pnpm build && node --test --test-concurrency=1 verification/cross-host/*.test.mjs",
    "test:release": "node --test --test-concurrency=1 scripts/release.test.mjs",
    "test:tooling": "node --test --test-concurrency=1 scripts/*.test.mjs",
    "verify:theory": "pnpm -r --workspace-concurrency=1 --if-present verify:theory",
    "verify:reproducible-build": "pnpm -r --workspace-concurrency=1 --if-present verify:reproducible-build",
    "check:boundaries": "node scripts/check-workspace-boundaries.mjs",
    "check:components": "node scripts/check-component-completeness.mjs",
    "check:component-api": "pnpm -r --workspace-concurrency=1 --filter @sectile/core --filter @sectile/temporal --filter @sectile/virtual --filter @sectile/tabular --filter @sectile/dom --filter @sectile/terminal --filter @sectile/vue --if-present build && node scripts/check-component-public-api.mjs",
    "check:signatures": "node scripts/check-public-signatures.mjs",
    "update:signatures": "node scripts/update-public-signatures.mjs",
    "update:tree": "node scripts/update-tree.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:release": "node scripts/verify.mjs",
    "verify:compat": "node scripts/verify.mjs --compat",
    "release": "node scripts/release.mjs",
    "release:check": "node scripts/check-release.mjs",
    "publish:packages": "node scripts/publish-packages.mjs"
  },
  "devDependencies": {
    "@sectile/core": "workspace:*",
    "@sectile/dom": "workspace:*",
    "@sectile/form": "workspace:*",
    "@sectile/tabular": "workspace:*",
    "@sectile/terminal": "workspace:*",
    "@sectile/vue": "workspace:*",
    "@sectile/temporal": "workspace:*",
    "@sectile/virtual": "workspace:*"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
