{
  "name": "sectile",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/run-workspace-command.mjs workspace-build -- pnpm run build:workspace",
    "build:workspace": "pnpm -r --workspace-concurrency=1 --if-present build",
    "typecheck": "node scripts/run-workspace-command.mjs workspace-typecheck -- pnpm run typecheck:workspace",
    "typecheck:workspace": "pnpm run build:workspace && pnpm -r --workspace-concurrency=1 --if-present typecheck",
    "test": "node scripts/run-workspace-command.mjs workspace-test -- pnpm run test:workspace",
    "test:workspace": "pnpm run build:workspace && pnpm -r --workspace-concurrency=1 --if-present test && node --test --test-concurrency=1 verification/cross-host/*.test.mjs && pnpm test:tooling",
    "test:cross-host": "node scripts/run-workspace-command.mjs cross-host-test -- pnpm run test:cross-host:local",
    "test:cross-host:local": "pnpm run build:workspace && node --test --test-concurrency=1 verification/cross-host/*.test.mjs",
    "test:release": "node --test --test-concurrency=1 scripts/release.test.mjs",
    "test:tooling": "node --test --test-concurrency=1 scripts/*.test.mjs",
    "performance:record": "node scripts/performance/run.mjs record",
    "performance:promote": "node scripts/performance/promote.mjs",
    "performance:compare": "node scripts/performance/run.mjs compare",
    "performance:check": "node scripts/performance/run.mjs check",
    "check:performance-gates": "node scripts/check-performance-gates.mjs",
    "performance:certify": "pnpm check:performance-gates && node scripts/performance/run.mjs check --all",
    "verify:performance": "pnpm performance:certify",
    "check:lifecycle-retention": "node scripts/lifecycle-retention.mjs",
    "check:validation-artifacts": "node scripts/check-validation-artifacts.mjs",
    "update:complexity": "pnpm run build:workspace && node scripts/check-complexity-contracts.mjs --write",
    "check:complexity": "pnpm run build:workspace && node scripts/check-complexity-contracts.mjs",
    "check:algorithm-reuse": "node scripts/check-algorithm-reuse.mjs",
    "update:algorithm-reuse": "node scripts/update-algorithm-reuse.mjs",
    "record:crossovers": "node scripts/representation-crossovers.mjs record",
    "check:crossovers": "node scripts/representation-crossovers.mjs check",
    "test:complexity": "node --test --test-concurrency=1 scripts/complexity-contracts.test.mjs scripts/complexity-witnesses.test.mjs",
    "update:consumer-surfaces": "pnpm run build:workspace && node scripts/update-consumer-surfaces.mjs",
    "record:consumer-bundles": "pnpm run build:workspace && node scripts/consumer-bundles/run.mjs record",
    "check:consumer-bundles": "pnpm run build:workspace && node scripts/consumer-bundles/run.mjs check",
    "update:breaking-baseline": "pnpm run build:workspace && node scripts/update-breaking-baseline.mjs",
    "check:breaking-changes": "node scripts/check-breaking-changes.mjs",
    "update:breaking-documentation": "node scripts/update-breaking-documentation.mjs",
    "check:workstream-ownership": "node scripts/check-workstream-ownership.mjs",
    "record:consumer-install": "pnpm run build:workspace && node scripts/consumer-install/run.mjs record",
    "check:consumer-install": "pnpm run build:workspace && node scripts/consumer-install/run.mjs check",
    "record:source-maps": "pnpm run build:workspace && node scripts/source-map-policy.mjs record",
    "check:source-maps": "pnpm run build:workspace && node scripts/source-map-policy.mjs check",
    "check:entrypoint-migrations": "node scripts/check-entrypoint-migrations.mjs",
    "check:public-change-gates": "node scripts/check-public-change-gates.mjs",
    "verify:public-change-gates": "pnpm run build:workspace && node scripts/check-public-change-gates.mjs --full",
    "verify:theory": "pnpm -r --workspace-concurrency=1 --if-present verify:theory",
    "verify:reproducible-build": "node scripts/run-workspace-command.mjs reproducible-build-verification -- pnpm run verify:reproducible-build:workspace",
    "verify:reproducible-build:workspace": "pnpm -r --workspace-concurrency=1 --if-present verify:reproducible-build",
    "check:boundaries": "node scripts/check-workspace-boundaries.mjs",
    "check:components": "node scripts/check-component-completeness.mjs",
    "check:semantic-authority": "node scripts/check-semantic-authority.mjs",
    "check:form-scenarios": "node scripts/check-form-scenarios.mjs",
    "check:component-api": "node scripts/run-workspace-command.mjs component-api-check -- pnpm run check:component-api:local",
    "check:component-api:local": "pnpm -r --workspace-concurrency=1 --filter @sectile/core --filter @sectile/temporal --filter @sectile/virtual --filter @sectile/tabular --filter @sectile/dom --filter @sectile/terminal --filter @sectile/vue --if-present build && node scripts/check-component-public-api.mjs",
    "check:signatures": "node scripts/check-public-signatures.mjs",
    "update:signatures": "node scripts/update-public-signatures.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:full": "node scripts/verify.mjs --full",
    "verify:release": "node scripts/verify.mjs --release",
    "verify:compat": "node scripts/verify.mjs --compat",
    "release": "node scripts/release.mjs",
    "release:plan": "node scripts/release.mjs --dry-run",
    "release:check": "node scripts/check-release.mjs",
    "publish:packages": "node scripts/run-workspace-command.mjs --verbose package-publication -- pnpm run publish:packages:local",
    "publish:packages:local": "node scripts/publish-packages.mjs"
  },
  "devDependencies": {
    "@sectile/chart": "workspace:*",
    "@sectile/core": "workspace:*",
    "@sectile/dom": "workspace:*",
    "@sectile/form": "workspace:*",
    "@sectile/tabular": "workspace:*",
    "@sectile/temporal": "workspace:*",
    "@sectile/terminal": "workspace:*",
    "@sectile/virtual": "workspace:*",
    "@sectile/vue": "workspace:*",
    "esbuild": "0.21.5",
    "terser": "5.51.2"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
