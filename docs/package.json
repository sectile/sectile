{
  "name": "@sectile/docs",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @sectile/core --filter @sectile/temporal --filter @sectile/virtual --filter @sectile/dom --filter @sectile/terminal --filter @sectile/vue build",
    "dev": "vitepress dev --host 127.0.0.1",
    "build": "vitepress build",
    "preview": "vitepress preview --host 127.0.0.1",
    "generate": "node scripts/generate-component-pages.mjs",
    "generate:check": "node scripts/generate-component-pages.mjs --check",
    "typecheck": "vue-tsc --noEmit",
    "verify": "pnpm generate:check && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@leaningtech/cheerpx": "^1.3.9",
    "@lucide/vue": "^1.33.0",
    "@sectile/core": "workspace:*",
    "@sectile/dom": "workspace:*",
    "@sectile/terminal": "workspace:*",
    "@sectile/vue": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "vue": "^3.5.22",
    "@sectile/temporal": "workspace:*",
    "@sectile/virtual": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "prettier": "^3.9.6",
    "shiki": "^4.4.3",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitepress": "^1.6.4",
    "vue-tsc": "^3.0.6"
  }
}
