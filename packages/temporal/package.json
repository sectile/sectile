{
  "name": "@sectile/temporal",
  "version": "0.14.1",
  "description": "Renderer-neutral date and time field, calendar, and picker semantics for Sectile.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sectile/sectile.git",
    "directory": "packages/temporal"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./date-field": {
      "types": "./dist/date-field.d.ts",
      "import": "./dist/date-field.js",
      "default": "./dist/date-field.js"
    },
    "./date-range-field": {
      "types": "./dist/date-range-field.d.ts",
      "import": "./dist/date-range-field.js",
      "default": "./dist/date-range-field.js"
    },
    "./date-time-field": {
      "types": "./dist/date-time-field.d.ts",
      "import": "./dist/date-time-field.js",
      "default": "./dist/date-time-field.js"
    },
    "./time-field": {
      "types": "./dist/time-field.d.ts",
      "import": "./dist/time-field.js",
      "default": "./dist/time-field.js"
    },
    "./time-range-field": {
      "types": "./dist/time-range-field.d.ts",
      "import": "./dist/time-range-field.js",
      "default": "./dist/time-range-field.js"
    },
    "./calendar": {
      "types": "./dist/calendar.d.ts",
      "import": "./dist/calendar.js",
      "default": "./dist/calendar.js"
    },
    "./date-picker": {
      "types": "./dist/date-picker.d.ts",
      "import": "./dist/date-picker.js",
      "default": "./dist/date-picker.js"
    },
    "./date-range-picker": {
      "types": "./dist/date-range-picker.d.ts",
      "import": "./dist/date-range-picker.js",
      "default": "./dist/date-range-picker.js"
    },
    "./range-calendar": {
      "types": "./dist/range-calendar.d.ts",
      "import": "./dist/range-calendar.js",
      "default": "./dist/range-calendar.js"
    },
    "./month-picker": {
      "types": "./dist/month-picker.d.ts",
      "import": "./dist/month-picker.js",
      "default": "./dist/month-picker.js"
    },
    "./month-range-picker": {
      "types": "./dist/month-range-picker.d.ts",
      "import": "./dist/month-range-picker.js",
      "default": "./dist/month-range-picker.js"
    },
    "./year-picker": {
      "types": "./dist/year-picker.d.ts",
      "import": "./dist/year-picker.js",
      "default": "./dist/year-picker.js"
    },
    "./year-range-picker": {
      "types": "./dist/year-range-picker.d.ts",
      "import": "./dist/year-range-picker.js",
      "default": "./dist/year-range-picker.js"
    },
    "./date-time-picker": {
      "types": "./dist/date-time-picker.d.ts",
      "import": "./dist/date-time-picker.js",
      "default": "./dist/date-time-picker.js"
    },
    "./date-time-range-picker": {
      "types": "./dist/date-time-range-picker.d.ts",
      "import": "./dist/date-time-range-picker.js",
      "default": "./dist/date-time-range-picker.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs production",
    "build:verification": "node scripts/build.mjs verification",
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "pnpm --silent run build:verification && node --test --test-concurrency=1 tests/*/*.test.mjs",
    "check:laws": "node scripts/check-laws.mjs",
    "check:package": "node scripts/check-package.mjs",
    "verify:reproducible-build": "node scripts/check-reproducible-build.mjs",
    "verify:reproducible-build:prepared": "node scripts/check-reproducible-build.mjs --prepared"
  },
  "dependencies": {
    "@sectile/core": "workspace:^"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
