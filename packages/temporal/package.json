{
  "name": "@sectile/temporal",
  "version": "0.14.9",
  "description": "Renderer-neutral date and time field, calendar, and picker semantics for Sectile.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sectile/sectile.git",
    "directory": "packages/temporal"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./date-field": {
      "types": "./dist/fields/date.d.ts",
      "import": "./dist/fields/date.js",
      "default": "./dist/fields/date.js"
    },
    "./date-range-field": {
      "types": "./dist/fields/date-range.d.ts",
      "import": "./dist/fields/date-range.js",
      "default": "./dist/fields/date-range.js"
    },
    "./date-time-field": {
      "types": "./dist/fields/date-time.d.ts",
      "import": "./dist/fields/date-time.js",
      "default": "./dist/fields/date-time.js"
    },
    "./time-field": {
      "types": "./dist/fields/time.d.ts",
      "import": "./dist/fields/time.js",
      "default": "./dist/fields/time.js"
    },
    "./time-range-field": {
      "types": "./dist/fields/time-range.d.ts",
      "import": "./dist/fields/time-range.js",
      "default": "./dist/fields/time-range.js"
    },
    "./calendar": {
      "types": "./dist/calendar.d.ts",
      "import": "./dist/calendar.js",
      "default": "./dist/calendar.js"
    },
    "./date-picker": {
      "types": "./dist/pickers/date.d.ts",
      "import": "./dist/pickers/date.js",
      "default": "./dist/pickers/date.js"
    },
    "./date-range-picker": {
      "types": "./dist/pickers/date-range.d.ts",
      "import": "./dist/pickers/date-range.js",
      "default": "./dist/pickers/date-range.js"
    },
    "./range-calendar": {
      "types": "./dist/pickers/range-calendar.d.ts",
      "import": "./dist/pickers/range-calendar.js",
      "default": "./dist/pickers/range-calendar.js"
    },
    "./month-picker": {
      "types": "./dist/pickers/period/month.d.ts",
      "import": "./dist/pickers/period/month.js",
      "default": "./dist/pickers/period/month.js"
    },
    "./month-range-picker": {
      "types": "./dist/pickers/period/month-range.d.ts",
      "import": "./dist/pickers/period/month-range.js",
      "default": "./dist/pickers/period/month-range.js"
    },
    "./year-picker": {
      "types": "./dist/pickers/period/year.d.ts",
      "import": "./dist/pickers/period/year.js",
      "default": "./dist/pickers/period/year.js"
    },
    "./year-range-picker": {
      "types": "./dist/pickers/period/year-range.d.ts",
      "import": "./dist/pickers/period/year-range.js",
      "default": "./dist/pickers/period/year-range.js"
    },
    "./date-time-picker": {
      "types": "./dist/pickers/date-time.d.ts",
      "import": "./dist/pickers/date-time.js",
      "default": "./dist/pickers/date-time.js"
    },
    "./date-time-range-picker": {
      "types": "./dist/pickers/date-time-range.d.ts",
      "import": "./dist/pickers/date-time-range.js",
      "default": "./dist/pickers/date-time-range.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "sectile-build production",
    "build:verification": "sectile-build verification",
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "pnpm --silent run build:verification && node --test --test-concurrency=1 tests/*/*.test.mjs",
    "check:laws": "node scripts/check-laws.mjs",
    "check:package": "node scripts/check-package.mjs",
    "verify:reproducible-build": "sectile-check-build"
  },
  "dependencies": {
    "@sectile/core": "workspace:^"
  },
  "devDependencies": {
    "@sectile/tooling": "workspace:*",
    "typescript": "7.0.2"
  }
}
