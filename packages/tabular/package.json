{
  "name": "@sectile/tabular",
  "version": "0.14.0",
  "description": "Renderer-neutral tabular data and interaction semantics for Sectile.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sectile/sectile.git",
    "directory": "packages/tabular"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "import": "./dist/model.js",
      "default": "./dist/model.js"
    },
    "./query": {
      "types": "./dist/query.d.ts",
      "import": "./dist/query.js",
      "default": "./dist/query.js"
    },
    "./source": {
      "types": "./dist/source.d.ts",
      "import": "./dist/source.js",
      "default": "./dist/source.js"
    },
    "./data-table": {
      "types": "./dist/data-table.d.ts",
      "import": "./dist/data-table.js",
      "default": "./dist/data-table.js"
    },
    "./data-grid": {
      "types": "./dist/data-grid.d.ts",
      "import": "./dist/data-grid.js",
      "default": "./dist/data-grid.js"
    },
    "./data-tree-grid": {
      "types": "./dist/data-tree-grid.d.ts",
      "import": "./dist/data-tree-grid.js",
      "default": "./dist/data-tree-grid.js"
    },
    "./virtual": {
      "types": "./dist/virtual.d.ts",
      "import": "./dist/virtual.js",
      "default": "./dist/virtual.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs production",
    "build:verification": "node scripts/build.mjs verification",
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "pnpm --silent run build:verification && node --test --test-concurrency=1 tests/advanced/*.test.mjs tests/architecture/*.test.mjs tests/columns/*.test.mjs tests/model/*.test.mjs tests/profiles/*.test.mjs tests/selection/*.test.mjs tests/source/*.test.mjs tests/virtual/*.test.mjs",
    "test:model": "node scripts/run-test-group.mjs model",
    "test:source": "node scripts/run-test-group.mjs source",
    "test:columns": "node scripts/run-test-group.mjs columns",
    "test:selection": "node scripts/run-test-group.mjs selection",
    "test:advanced": "node scripts/run-test-group.mjs advanced",
    "test:profiles": "node scripts/run-test-group.mjs profiles",
    "test:architecture": "node --test --test-concurrency=1 tests/architecture/*.test.mjs",
    "test:virtual": "node scripts/run-test-group.mjs virtual",
    "test:virtual:witnesses": "node scripts/run-test-group.mjs virtual-witnesses",
    "verify:model": "node scripts/verify-model.mjs",
    "check:laws": "node scripts/check-laws.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:implementation": "node scripts/check-implementation-verification.mjs",
    "verify:reproducible-build": "node scripts/check-reproducible-build.mjs",
    "benchmark": "pnpm --silent run build && node --expose-gc benchmarks/tabular.mjs"
  },
  "dependencies": {
    "@sectile/core": "workspace:*"
  },
  "peerDependencies": {
    "@sectile/virtual": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@sectile/virtual": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sectile/virtual": "workspace:*",
    "typescript": "7.0.2"
  }
}
