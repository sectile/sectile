    "benchmark:chart": "pnpm --silent run build && node benchmarks/chart-reconciliation.mjs",
    "check:controlled-reconciliation": "node scripts/check-controlled-reconciliation.mjs",
    "check:hydration-contract": "node scripts/check-hydration-contract.mjs",
    "serve:browser-verification": "pnpm --silent run build && node scripts/serve-browser-verification.mjs",
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "typecheck:public": "pnpm --silent run build && pnpm --silent run typecheck:public:prepared",
    "typecheck:public:prepared": "tsc --project type-tests/tsconfig.json --pretty false && sectile-typecheck-sfc --project type-tests/tsconfig.vue.json --noEmit",
    "test": "pnpm --silent run build:verification && node --test --test-concurrency=4 tests/*.test.mjs",
    "verify:reproducible-build": "sectile-check-build"
