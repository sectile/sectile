{
  "name": "@sectile/vue",
  "version": "0.1.0",
  "private": true,
  "description": "Headless Vue components for Sectile DOM interaction semantics.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jinyongp/sectile.git",
    "directory": "packages/vue"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./checkbox": {
      "types": "./dist/checkbox.d.ts",
      "import": "./dist/checkbox.js",
      "default": "./dist/checkbox.js"
    },
    "./primitive": {
      "types": "./dist/primitive.d.ts",
      "import": "./dist/primitive.js",
      "default": "./dist/primitive.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "pnpm --silent run build && node --test tests/*.test.mjs",
    "verify": "pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@sectile/dom": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vue/server-renderer": "^3.5.0",
    "typescript": "7.0.2",
    "vue": "^3.5.0"
  }
}
