{
  "name": "@sectile/chart",
  "version": "0.14.0",
  "description": "Renderer-neutral chart models, interaction, and packed projections for Sectile.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sectile/sectile.git",
    "directory": "packages/chart"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "import": "./dist/model.js",
      "default": "./dist/model.js"
    },
    "./result": {
      "types": "./dist/result.d.ts",
      "import": "./dist/result.js",
      "default": "./dist/result.js"
    },
    "./scale": {
      "types": "./dist/scale.d.ts",
      "import": "./dist/scale.js",
      "default": "./dist/scale.js"
    },
    "./projection": {
      "types": "./dist/projection.d.ts",
      "import": "./dist/projection.js",
      "default": "./dist/projection.js"
    },
    "./query": {
      "types": "./dist/query.d.ts",
      "import": "./dist/query.js",
      "default": "./dist/query.js"
    },
    "./interaction": {
      "types": "./dist/interaction.d.ts",
      "import": "./dist/interaction.js",
      "default": "./dist/interaction.js"
    },
    "./controller": {
      "types": "./dist/controller.d.ts",
      "import": "./dist/controller.js",
      "default": "./dist/controller.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js",
      "default": "./dist/contract.js"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "import": "./dist/layout.js",
      "default": "./dist/layout.js"
    },
    "./definition": {
      "types": "./dist/definition.d.ts",
      "import": "./dist/definition.js",
      "default": "./dist/definition.js"
    },
    "./view": {
      "types": "./dist/view.d.ts",
      "import": "./dist/view.js",
      "default": "./dist/view.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs production",
    "build:verification": "node scripts/build.mjs verification",
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "typecheck:public": "pnpm --silent run build && tsc --project type-tests/tsconfig.json --pretty false",
    "test": "pnpm --silent run build:verification && node --test --test-concurrency=1 tests/*/*.test.mjs",
    "benchmark": "pnpm --silent run build && node benchmarks/projection.mjs",
    "benchmark:model-repair": "pnpm --silent run build && node benchmarks/model-repair.mjs",
    "benchmark:semantic-projection": "pnpm --silent run build && node benchmarks/semantic-projection.mjs",
    "benchmark:view-transition": "pnpm --silent run build && node benchmarks/view-transition.mjs",
    "benchmark:retention": "pnpm --silent run build && node --expose-gc benchmarks/retention.mjs",
    "check:laws": "node scripts/check-laws.mjs",
    "check:package": "node scripts/check-package.mjs",
    "verify:reproducible-build": "node scripts/check-reproducible-build.mjs"
  },
  "dependencies": {
    "@sectile/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
