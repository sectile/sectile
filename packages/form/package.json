{
  "name": "@sectile/form",
  "version": "0.13.0",
  "description": "Renderer-neutral form paths, values, validation, and submission state for Sectile.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sectile/sectile.git",
    "directory": "packages/form"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./error": {
      "types": "./dist/error.d.ts",
      "import": "./dist/error.js",
      "default": "./dist/error.js"
    },
    "./path": {
      "types": "./dist/path.d.ts",
      "import": "./dist/path.js",
      "default": "./dist/path.js"
    },
    "./values": {
      "types": "./dist/values.d.ts",
      "import": "./dist/values.js",
      "default": "./dist/values.js"
    },
    "./state": {
      "types": "./dist/state.d.ts",
      "import": "./dist/state.js",
      "default": "./dist/state.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "default": "./dist/schema.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs production",
    "build:verification": "node scripts/build.mjs verification",
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "pnpm --silent run build:verification && node --test --test-concurrency=1 tests/*/*.test.mjs",
    "check:laws": "node scripts/check-laws.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:public-api": "node scripts/check-public-signatures.mjs",
    "verify:reproducible-build": "node scripts/check-reproducible-build.mjs"
  },
  "dependencies": {
    "@sectile/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
