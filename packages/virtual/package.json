{
  "name": "@sectile/virtual",
  "version": "0.7.0",
  "description": "Renderer-neutral dynamic virtualization and layout semantics for Sectile.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sectile/sectile.git",
    "directory": "packages/virtual"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./extent-index": {
      "types": "./dist/extent-index.d.ts",
      "import": "./dist/extent-index.js",
      "default": "./dist/extent-index.js"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "import": "./dist/layout.js",
      "default": "./dist/layout.js"
    },
    "./linear-layout": {
      "types": "./dist/linear-layout.d.ts",
      "import": "./dist/linear-layout.js",
      "default": "./dist/linear-layout.js"
    },
    "./masonry-layout": {
      "types": "./dist/masonry-layout.d.ts",
      "import": "./dist/masonry-layout.js",
      "default": "./dist/masonry-layout.js"
    },
    "./partitioned-track-grid-layout": {
      "types": "./dist/partitioned-track-grid-layout.d.ts",
      "import": "./dist/partitioned-track-grid-layout.js",
      "default": "./dist/partitioned-track-grid-layout.js"
    },
    "./spatial-layout": {
      "types": "./dist/spatial-layout.d.ts",
      "import": "./dist/spatial-layout.js",
      "default": "./dist/spatial-layout.js"
    },
    "./track-grid-layout": {
      "types": "./dist/track-grid-layout.d.ts",
      "import": "./dist/track-grid-layout.js",
      "default": "./dist/track-grid-layout.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs production",
    "build:verification": "node scripts/build.mjs verification",
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "pnpm --silent run build:verification && node --test --test-concurrency=1 tests/*/*.test.mjs",
    "benchmark": "pnpm --silent run build && node benchmarks/virtualization.mjs",
    "check:laws": "node scripts/check-laws.mjs",
    "check:package": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "@sectile/core": "workspace:*"
  },
  "devDependencies": {
    "@chenglou/pretext": "0.0.8",
    "typescript": "7.0.2"
  }
}
