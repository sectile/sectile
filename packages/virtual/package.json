{
  "name": "@sectile/virtual",
  "version": "0.15.4",
  "description": "Renderer-neutral dynamic virtualization and layout semantics for Sectile.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sectile/sectile.git",
    "directory": "packages/virtual"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./collection": {
      "types": "./dist/collection.d.ts",
      "import": "./dist/collection.js",
      "default": "./dist/collection.js"
    },
    "./extent-index": {
      "types": "./dist/indexes/extent.d.ts",
      "import": "./dist/indexes/extent.js",
      "default": "./dist/indexes/extent.js"
    },
    "./layout": {
      "types": "./dist/layout/plan.d.ts",
      "import": "./dist/layout/plan.js",
      "default": "./dist/layout/plan.js"
    },
    "./linear-layout": {
      "types": "./dist/layout/linear.d.ts",
      "import": "./dist/layout/linear.js",
      "default": "./dist/layout/linear.js"
    },
    "./masonry-layout": {
      "types": "./dist/layout/masonry/layout.d.ts",
      "import": "./dist/layout/masonry/layout.js",
      "default": "./dist/layout/masonry/layout.js"
    },
    "./partitioned-track-grid-layout": {
      "types": "./dist/layout/grid/partitioned.d.ts",
      "import": "./dist/layout/grid/partitioned.js",
      "default": "./dist/layout/grid/partitioned.js"
    },
    "./spatial-layout": {
      "types": "./dist/layout/spatial.d.ts",
      "import": "./dist/layout/spatial.js",
      "default": "./dist/layout/spatial.js"
    },
    "./surface": {
      "types": "./dist/surface.d.ts",
      "import": "./dist/surface.js",
      "default": "./dist/surface.js"
    },
    "./track-grid-layout": {
      "types": "./dist/layout/grid/layout.d.ts",
      "import": "./dist/layout/grid/layout.js",
      "default": "./dist/layout/grid/layout.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "sectile-build production",
    "build:verification": "sectile-build verification",
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "typecheck:public": "pnpm --silent run build && pnpm --silent run typecheck:public:prepared",
    "test": "pnpm --silent run build:verification && node --test --test-concurrency=1 tests/*/*.test.mjs",
    "benchmark": "pnpm --silent run build && node benchmarks/virtualization.mjs",
    "check:laws": "node scripts/check-laws.mjs",
    "check:package": "node scripts/check-package.mjs",
    "verify:reproducible-build": "sectile-check-build",
    "typecheck:public:prepared": "tsc --project type-tests/tsconfig.json --pretty false"
  },
  "dependencies": {
    "@sectile/core": "workspace:^"
  },
  "devDependencies": {
    "@sectile/tooling": "workspace:*",
    "@chenglou/pretext": "0.0.8",
    "typescript": "7.0.2"
  }
}
