{
  "name": "@sectile/primitives",
  "version": "0.0.0",
  "private": true,
  "description": "Renderer-neutral canonical interaction structures with explicit laws, failures, and costs.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sequence": {
      "types": "./dist/structures/sequence.d.ts",
      "import": "./dist/structures/sequence.js",
      "default": "./dist/structures/sequence.js"
    },
    "./range": {
      "types": "./dist/structures/range.d.ts",
      "import": "./dist/structures/range.js",
      "default": "./dist/structures/range.js"
    },
    "./grid": {
      "types": "./dist/structures/grid.d.ts",
      "import": "./dist/structures/grid.js",
      "default": "./dist/structures/grid.js"
    },
    "./tree": {
      "types": "./dist/structures/tree.d.ts",
      "import": "./dist/structures/tree.js",
      "default": "./dist/structures/tree.js"
    },
    "./listbox": {
      "types": "./dist/listbox.d.ts",
      "import": "./dist/listbox.js",
      "default": "./dist/listbox.js"
    },
    "./calendar": {
      "types": "./dist/calendar.d.ts",
      "import": "./dist/calendar.js",
      "default": "./dist/calendar.js"
    },
    "./combobox": {
      "types": "./dist/combobox.d.ts",
      "import": "./dist/combobox.js",
      "default": "./dist/combobox.js"
    },
    "./slider": {
      "types": "./dist/slider.d.ts",
      "import": "./dist/slider.js",
      "default": "./dist/slider.js"
    },
    "./tree-view": {
      "types": "./dist/tree-view.d.ts",
      "import": "./dist/tree-view.js",
      "default": "./dist/tree-view.js"
    },
    "./revision": {
      "types": "./dist/revision.d.ts",
      "import": "./dist/revision.js",
      "default": "./dist/revision.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs production",
    "build:verification": "node scripts/build.mjs verification",
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "pnpm --silent run build:verification && node --test tests/*/*.test.mjs",
    "benchmark": "pnpm run build && node benchmarks/structures.mjs",
    "verify:theory": "node scripts/verify-theory.mjs",
    "verify:reproducible-build": "node scripts/check-reproducible-build.mjs",
    "check:contracts": "node scripts/check-contracts.mjs",
    "check:public-api": "node scripts/check-public-api.mjs",
    "check:api-stability": "node scripts/check-api-stability.mjs",
    "check:signatures": "node scripts/check-public-signatures.mjs",
    "check:laws": "node scripts/check-law-coverage.mjs",
    "check:naming": "node scripts/check-acronym-casing.mjs",
    "check:layout": "node scripts/check-layout.mjs",
    "check:dist-boundary": "node scripts/check-dist-platform-boundary.mjs",
    "check:subpaths": "node scripts/check-subpath-imports.mjs",
    "check:package": "node scripts/check-package-footprint.mjs",
    "check:verification": "node scripts/check-verification.mjs",
    "update:api-stability": "node scripts/update-api-stability.mjs",
    "update:signatures": "node scripts/update-public-signatures.mjs",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:contracts && pnpm run check:public-api && pnpm run check:api-stability && pnpm run check:signatures && pnpm run check:laws && pnpm run check:naming && pnpm run check:layout && pnpm run check:dist-boundary && pnpm run check:subpaths && pnpm run check:package && pnpm run check:verification"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
