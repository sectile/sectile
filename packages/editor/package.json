{
  "name": "@sectile/editor",
  "version": "0.1.0",
  "description": "Renderer-neutral structured authoring sessions, transactions, actions, and history for Sectile Portable Content.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sectile/sectile.git",
    "directory": "packages/editor"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./action": {
      "types": "./dist/action.d.ts",
      "import": "./dist/action.js",
      "default": "./dist/action.js"
    },
    "./authoring": {
      "types": "./dist/authoring.d.ts",
      "import": "./dist/authoring.js",
      "default": "./dist/authoring.js"
    },
    "./error": {
      "types": "./dist/error.d.ts",
      "import": "./dist/error.js",
      "default": "./dist/error.js"
    },
    "./history": {
      "types": "./dist/history.d.ts",
      "import": "./dist/history.js",
      "default": "./dist/history.js"
    },
    "./selection": {
      "types": "./dist/selection.d.ts",
      "import": "./dist/selection.js",
      "default": "./dist/selection.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js",
      "default": "./dist/session.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "sectile-build production",
    "build:verification": "sectile-build verification",
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "typecheck:public": "pnpm --silent run build && pnpm --silent run typecheck:public:prepared",
    "typecheck:public:prepared": "tsc --project type-tests/tsconfig.json --pretty false",
    "test": "sectile-build verification && node --test --test-concurrency=1 tests/*.test.mjs",
    "benchmark": "pnpm --silent run build && node --expose-gc benchmarks/session-proof.mjs",
    "check:laws": "node scripts/check-laws.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:public-api": "sectile-check-signatures",
    "verify:reproducible-build": "sectile-check-build"
  },
  "dependencies": {
    "@sectile/content": "workspace:^",
    "@sectile/core": "workspace:^"
  },
  "devDependencies": {
    "@sectile/tooling": "workspace:*",
    "typescript": "7.0.2"
  }
}
