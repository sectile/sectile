{
  "name": "@sectile/terminal",
  "version": "0.0.0",
  "private": true,
  "description": "Terminal host adapters for Sectile semantic interaction machines.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./listbox": {
      "types": "./dist/listbox.d.ts",
      "import": "./dist/listbox.js",
      "default": "./dist/listbox.js"
    },
    "./tabs": {
      "types": "./dist/tabs.d.ts",
      "import": "./dist/tabs.js",
      "default": "./dist/tabs.js"
    },
    "./radio-group": {
      "types": "./dist/radio-group.d.ts",
      "import": "./dist/radio-group.js",
      "default": "./dist/radio-group.js"
    },
    "./toolbar": {
      "types": "./dist/toolbar.d.ts",
      "import": "./dist/toolbar.js",
      "default": "./dist/toolbar.js"
    },
    "./disclosure": {
      "types": "./dist/disclosure.d.ts",
      "import": "./dist/disclosure.js",
      "default": "./dist/disclosure.js"
    },
    "./accordion": {
      "types": "./dist/accordion.d.ts",
      "import": "./dist/accordion.js",
      "default": "./dist/accordion.js"
    },
    "./checkbox": { "types": "./dist/checkbox.d.ts", "import": "./dist/checkbox.js", "default": "./dist/checkbox.js" },
    "./switch": { "types": "./dist/switch.d.ts", "import": "./dist/switch.js", "default": "./dist/switch.js" },
    "./toggle-button": { "types": "./dist/toggle-button.d.ts", "import": "./dist/toggle-button.js", "default": "./dist/toggle-button.js" },
    "./calendar": {
      "types": "./dist/calendar.d.ts",
      "import": "./dist/calendar.js",
      "default": "./dist/calendar.js"
    },
    "./combobox": {
      "types": "./dist/combobox.d.ts",
      "import": "./dist/combobox.js",
      "default": "./dist/combobox.js"
    },
    "./slider": {
      "types": "./dist/slider.d.ts",
      "import": "./dist/slider.js",
      "default": "./dist/slider.js"
    },
    "./tree-view": {
      "types": "./dist/tree-view.d.ts",
      "import": "./dist/tree-view.js",
      "default": "./dist/tree-view.js"
    },
    "./tree-grid": {
      "types": "./dist/tree-grid.d.ts",
      "import": "./dist/tree-grid.js",
      "default": "./dist/tree-grid.js"
    },
    "./keyboard": {
      "types": "./dist/keyboard.d.ts",
      "import": "./dist/keyboard.js",
      "default": "./dist/keyboard.js"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "import": "./dist/layout.js",
      "default": "./dist/layout.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./text": {
      "types": "./dist/text.d.ts",
      "import": "./dist/text.js",
      "default": "./dist/text.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "pnpm --silent run build && node --test tests/*.test.mjs",
    "verify": "pnpm run typecheck && pnpm run test",
    "verify:reproducible-build": "node scripts/check-reproducible-build.mjs"
  },
  "dependencies": {
    "@sectile/primitives": "workspace:*",
    "string-width": "8.1.0"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "7.0.2"
  }
}
