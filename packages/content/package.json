{
  "name": "@sectile/content",
  "version": "0.1.0",
  "description": "Portable structured content documents, schemas, transforms, and validation for Sectile.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sectile/sectile.git",
    "directory": "packages/content"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./document": {
      "types": "./dist/document.d.ts",
      "import": "./dist/document.js",
      "default": "./dist/document.js"
    },
    "./error": {
      "types": "./dist/error.d.ts",
      "import": "./dist/error.js",
      "default": "./dist/error.js"
    },
    "./fragment": {
      "types": "./dist/fragment.d.ts",
      "import": "./dist/fragment.js",
      "default": "./dist/fragment.js"
    },
    "./helpers": {
      "types": "./dist/helpers.d.ts",
      "import": "./dist/helpers.js",
      "default": "./dist/helpers.js"
    },
    "./limits": {
      "types": "./dist/limits.d.ts",
      "import": "./dist/limits.js",
      "default": "./dist/limits.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "default": "./dist/schema.js"
    },
    "./query": {
      "types": "./dist/query.d.ts",
      "import": "./dist/query.js",
      "default": "./dist/query.js"
    },
    "./position": {
      "types": "./dist/position.d.ts",
      "import": "./dist/position.js",
      "default": "./dist/position.js"
    },
    "./prepared": {
      "types": "./dist/prepared.d.ts",
      "import": "./dist/prepared.js",
      "default": "./dist/prepared.js"
    },
    "./transform": {
      "types": "./dist/transform.d.ts",
      "import": "./dist/transform.js",
      "default": "./dist/transform.js"
    },
    "./validate": {
      "types": "./dist/validate.d.ts",
      "import": "./dist/validate.js",
      "default": "./dist/validate.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "sectile-build production",
    "build:verification": "sectile-build verification",
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "typecheck:public": "pnpm --silent run build && pnpm --silent run typecheck:public:prepared",
    "typecheck:public:prepared": "tsc --project type-tests/tsconfig.json --pretty false",
    "test": "sectile-build verification && node --test --test-concurrency=1 tests/*.test.mjs",
    "benchmark": "pnpm --silent run build && node --expose-gc benchmarks/prepared-state-proof.mjs",
    "check:laws": "node scripts/check-laws.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:public-api": "sectile-check-signatures",
    "verify:reproducible-build": "sectile-check-build"
  },
  "dependencies": {
    "@sectile/core": "workspace:^"
  },
  "devDependencies": {
    "@sectile/tooling": "workspace:*",
    "typescript": "7.0.2"
  }
}
