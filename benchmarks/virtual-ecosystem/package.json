{
  "name": "@sectile/benchmark-virtual-ecosystem",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:docs": "vite build --base ./ --outDir ../../docs/public/benchmark-runner --emptyOutDir",
    "merge-shards": "node scripts/merge-shards.mjs",
    "test": "node --test src/adaptive-sampling.test.ts src/baseline-policy.test.ts src/constants.test.ts src/dom-runner.test.ts src/failure-reproduction.test.ts src/interactive-budget.test.ts src/layout-fixtures.test.ts src/layout-validation.test.ts src/react-virtualized-measurement.test.ts src/target-position.test.ts scripts/merge-shards.test.mjs scripts/result-normalization.test.mjs scripts/source-metadata.test.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@sectile/core": "workspace:*",
    "@sectile/vue": "workspace:*",
    "@sectile/virtual": "workspace:*",
    "@tanstack/react-virtual": "3.14.10",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-virtualized": "9.22.6",
    "react-virtuoso": "4.18.12",
    "react-window": "2.3.0",
    "virtua": "0.50.5",
    "vue": "3.5.22",
    "vue-virtual-scroller": "3.0.5"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/react-virtualized": "9.22.3",
    "typescript": "7.0.2",
    "vite": "5.4.21"
  }
}
