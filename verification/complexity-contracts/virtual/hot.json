      "benchmarkIDs": ["VAL-017:extent-index-work"],
      "specificationCeiling": "O(log n)",
      "contract": {
        "variables": [{ "name": "n", "meaning": "extent count", "ceiling": "maxItems" }],
        "time": { "bound": "O(log n)", "kind": "worst-case", "runtimeState": "trusted" },
        "proof": "Prefix-sum lookup descends the balanced extent index by one branch per level.",
        "adversarialWitness": "Lookup at the final offset of a maximum-size non-uniform extent index.",
        "fullScan": { "allowed": false, "rationale": "Indexed offset lookup must not visit every extent." }
      }
    },
