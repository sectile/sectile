          "kind": "expected",
          "runtimeState": "trusted"
        },
        "space": {
          "auxiliary": "O(1)",
          "output": "O(1)",
          "retained": "O(fField)"
        },
        "resources": {
          "allocations": "0",
          "cacheEntries": "O(fField)",
          "listeners": "0",
          "observers": "0",
          "timers": "0",
          "subscriptions": "0"
