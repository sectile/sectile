    { "id": "WI-008:dom-slider-retained-domain", "change": "signature-changed", "before": { "subpath": "./multi-thumb-slider" }, "symbols": ["MultiThumbSliderConnection", "MultiThumbSliderThumbAttributeOptions", "getMultiThumbSliderThumbAttributes"], "replacement": { "package": "@sectile/dom", "subpath": "./multi-thumb-slider" }, "removalReason": "Connection implementations and mocks must expose the retained domain sequence. The stateless thumb projection consumes that domain rather than reconstructing it." },
    { "id": "WI-008:dom-quantity-option-ownership", "change": "signature-changed", "before": { "subpath": "./quantity-field" }, "symbols": ["QuantityFieldOptions"], "replacement": { "package": "@sectile/dom", "subpath": "./quantity-field" }, "removalReason": "Adds optional manageUnitOptions for host-owned option rendering; existing callers retain the default native option owner." },
    { "id": "WI-008:dom-tree-reorder-targets", "change": "signature-changed", "before": { "subpath": "./reorder" }, "symbols": ["TreeReorderConnection", "TreeReorderOptions", "TreeReorderDropTarget"], "replacement": { "package": "@sectile/dom", "subpath": "./reorder" }, "removalReason": "Tree connection implementations and mocks must provide setDropTarget, removeDropTarget and canMove. Policies and column/read-only/direction options retain Core move semantics; new Core event variants require exhaustive consumers to handle atomic moves." },
    { "id": "WI-008:dom-timer-registration", "change": "signature-changed", "before": { "subpath": "./timer" }, "symbols": ["TimerConnection", "TimerErrorCode", "tryCreateTimer", "getTimerRootAttributes"], "replacement": { "package": "@sectile/dom", "subpath": "./timer" }, "removalReason": "Connection mocks need registerItem/registerAction retirement functions. Result consumers must handle dom.timer-interval-invalid in addition to Core errors; old setItemAttributes/setActionAttributes remain available." },
    { "id": "WI-008:dom-toast-queue-binding", "change": "signature-changed", "before": { "subpath": "./toast" }, "symbols": ["ToastConnection", "ToastQueueOptions", "ToastConfiguration", "ToastErrorCode"], "replacement": { "package": "@sectile/dom", "subpath": "./toast" }, "removalReason": "Connection implementations and mocks need setViewport and syncConfiguration; queue construction may omit the viewport. Handle dom.toast-interval-invalid, and preserve explicit null duration as persistent rather than defaulting it." },
