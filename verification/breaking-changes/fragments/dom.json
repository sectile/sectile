    {
      "id": "WI-030:dom-root-grid-control-closure",
      "change": "signature-changed",
      "before": { "subpath": "." },
      "symbols": ["GridEditMode", "GridPolicies", "GridState", "GridEvent", "TextConnection.handleEvent", "FacadeConnection<TextConnection>.send", "GridConnection.setCellAttributes", "DOMPopupConnection.prepareMove", "DOMPopupConnection.completeMove"],
      "replacement": { "package": "@sectile/dom", "subpath": "." },
      "removalReason": "Programmatic text transitions use handleEvent or send; handleBeforeInput is reserved for observing native beforeinput without cancellation. Popup connection implementations and mocks must supply prepareMove/completeMove; standard Dialog, AlertDialog, Drawer, Popover and Tooltip factories provide them. Pair a retained native move with these operations, or completeMove(false) to cancel; ordinary openings and close-focus defaults remain unchanged."
    },
