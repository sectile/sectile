    {
      "id": "WI-003:dom-virtual-surface-frame",
      "change": "signature-changed",
      "before": { "subpath": "./virtual" },
      "symbols": ["module side-effect import @sectile/virtual", "VirtualizerOptions.root", "VirtualizerOptions.scrollport", "VirtualizerOptions.surface", "VirtualizerOptions.viewportInsets", "VirtualizerConnection.registerFrame", "VirtualizerConnection.setViewportInsets", "VirtualScrollport", "VirtualViewportReader", "VirtualScrollWriter", "virtualContentStyle", "virtualSurfaceStyle"],
      "replacement": { "package": "@sectile/dom", "subpath": "./virtual" },
      "removalReason": "The DOM virtual entrypoint names the physical scrollport and surface separately, projects through the Virtual-owned surface frame, applies plan size through virtualSurfaceStyle, and now accepts the Sectile-owned VirtualScrollport union (HTMLElement | Document). Custom viewport readers and scroll writers accept either supported host target; Window is not a public target form."
    },
    {
